# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/stylesakhi
# OR for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stylesakhi

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Media Storage
# MEDIA_STORAGE_DRIVER:
# - local -> store on VPS disk
# - r2    -> store on Cloudflare R2
# - auto  -> use r2 if full R2 config is present, otherwise local
MEDIA_STORAGE_DRIVER=auto

BACKEND_PUBLIC_URL=http://localhost:5000
MEDIA_URL_PREFIX=/media
MEDIA_ROOT_DIR=media
MEDIA_IMAGE_MAX_DIMENSION=1600
MEDIA_BANNER_MAX_WIDTH=1920
MEDIA_BANNER_MAX_HEIGHT=1200
MEDIA_WEBP_QUALITY=82
MEDIA_UPLOAD_MAX_BYTES=125829120

# Cloudflare R2 (required when MEDIA_STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_S3_ENDPOINT=
# Public URL base for serving uploaded files, example:
# https://cdn.stylesakhi.com
# or https://<bucket>.<account_hash>.r2.dev
R2_PUBLIC_BASE_URL=
R2_FORCE_PATH_STYLE=true

# Razorpay (For payments)
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_KEY_SECRET=your-key-secret

# App
APP_NAME=StyleSakhi
FRONTEND_URL=http://localhost:3000
